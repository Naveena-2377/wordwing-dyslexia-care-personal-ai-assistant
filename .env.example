# ---- copy to .env and fill in. NEVER commit .env ----
APP_ENV=dev
LOG_LEVEL=INFO

# Database
POSTGRES_USER=dyslexia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dyslexia_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM / simplification fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Speech
WHISPER_MODEL=small
TTS_PROVIDER=coqui          # coqui | azure | google
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Image generation
IMAGEGEN_PROVIDER=stable_diffusion_api
IMAGEGEN_API_KEY=

# Storage
MODEL_DIR=./models
DATA_DIR=./data
